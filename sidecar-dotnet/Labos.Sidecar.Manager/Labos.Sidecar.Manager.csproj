<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Labos.Sidecar.Manager</AssemblyName>
    <RootNamespace>Labos.Sidecar.Manager</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      复用 sidecar 的三个文件（清单客户端 / Redis 客户端 / 传输层）：
      同一套"设备口径"和"Redis key 约定"只能有一份实现 ——
      两处各写一份，迟早两边对不上（那次"在线却显示离线"就是这么来的）。
      共享编译比抽 NuGet 包更省事：工位机上少一个依赖。
    -->
    <Compile Include="../Labos.Sidecar/DeviceRegistry.cs" Link="Shared/DeviceRegistry.cs" />
    <Compile Include="../Labos.Sidecar/RedisLinkState.cs" Link="Shared/RedisLinkState.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      wwwroot 显式复制到输出目录。
      为什么必须显式写：Web SDK 默认把静态资源当 Content，**CopyToOutputDirectory 是 Never**
      （开发时由 StaticWebAssets manifest 提供）⇒ 直接 `dotnet <dll>` 跑的时候
      页面 404（现场就是"管理台打开了是空白页"）。
      复制到输出目录后，`dotnet bin/.../Labos.Sidecar.Manager.dll` 就能直接跑。
    -->
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
