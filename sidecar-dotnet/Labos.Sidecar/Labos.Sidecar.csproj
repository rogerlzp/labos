<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Labos.Sidecar</AssemblyName>
    <RootNamespace>Labos.Sidecar</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 串口：.NET Core 起不在 BCL 里，要单独引用（只有 Windows/Linux/macOS 都支持才叫完整） -->
    <PackageReference Include="System.IO.Ports" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- 型号定义由 Java 侧导出（labos-kernel: DeviceModelExport），sidecar 不写死设备知识 -->
    <None Include="../models.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
