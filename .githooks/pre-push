#!/usr/bin/env bash
# ============================================================================
# pre-push 钩子：推送前按 diff 选档跑门禁（不再无条件 --all）
#
# 为什么需要：GitHub CI 只跑不需要数据库的部分；页面轨/链路/流程矩阵不在 CI 里，
# 最容易"本地看着绿了直接推"。但旧钩子无条件 ./scripts/ci-gate.sh --all
# （40 分钟级，设备段还要 30–45 秒/动作的仿真机），等于每次 push 都跑发布前全量。
#
# 现在的分工（对应 docs/测试总纲.md §2 / §3.3）：
#   · 只改文档      → verify-en-docs.py（秒级）
#   · 改了代码      → T0（ci-gate.sh 无参：阈值自检/纯逻辑/tsc/schema），分钟级
#   · T1 相关段     → 按 §4 映射表命中即**默认自动跑**（改动面 + 相关部分）
#   · 不设「全量必跑」：--all 只是可选的跨轨复核手段，绝非验收条件
#
# 启用（每个克隆各做一次）：
#   git config core.hooksPath .githooks
#
# 临时跳过（确实要推一个已知红灯的 WIP 分支）：
#   SKIP_GATE=1 git push        # 或 git push --no-verify
# ============================================================================
set -uo pipefail

if [[ "${SKIP_GATE:-0}" == "1" ]]; then
  echo "pre-push：SKIP_GATE=1，跳进门禁（本次未验证）"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT" || exit 1

echo "pre-push：按 diff 精确选段（只跑改动面及相关段）"
echo

if python3 scripts/gate-select.py --run; then
  echo
  echo "pre-push：所选段通过，放行推送"
  echo "          已跑：T0 + 命中的相关段；无全量必跑要求"
  exit 0
fi

echo
echo "pre-push：门禁未通过，推送已挡下。"
echo "          修完再推；确要跳过用：SKIP_GATE=1 git push"
exit 1
