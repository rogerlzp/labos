# 构建产物
labos-kernel/out/
labos-kernel/target/
labos-gateway/out/
# Python 脚本的字节码缓存（scripts/ 下有多个 .py）
__pycache__/
*.pyc
# PyLabRobot 仿真器的隔离虚拟环境
pylabrobot-sim/.venv/
# sidecar 的构建产能在子目录里（Labos.Sidecar/bin），必须用 ** 才匹配得到。
# 🔴 但带斜杠的模式会锚定到 .gitignore 所在目录，所以必须写成 **/sidecar-dotnet/...，
#    否则匹配不到 labos-kernel/sidecar-dotnet/obj/（构建产物会混进仓库）。
**/sidecar-dotnet/**/bin/
**/sidecar-dotnet/**/obj/
# 注意：不要带尾斜杠 —— 带斜杠只匹配目录，匹配不到符号链接。
# 曾经因为这个，node_modules 的软链被 git add -A 带进了仓库（自指软链，
# 新克隆直接坏掉）。
webapp/node_modules
webapp/dist/
out/
*.class

# 运行产物
# 截图默认不入库（避免误提交设备实物照）；文档里的界面截图单独白名单
*.png
!docs/images/run-detail-*.png
!docs/images/plates-*.png
!docs/images/preflight-*.png
!docs/images/paused-*.png
!docs/images/*-ui.png
# 设计器界面截图（网关对照图等）：文档里引用的**示意图**，不是设备实物照
!docs/media/designer-*.png
# 运行详情界面截图（同样是文档里的示意图）
!docs/media/rundetail-*.png
# 应用图标（favicon / 主屏 / PWA）：**不是设备实物照，是产品资源，必须入库**。
# 漏掉的后果：换个机器 clone 下来，浏览器标签页回退成默认图标 —— 现场以为是装错了。
!webapp/public/favicon-*.png
!webapp/public/icon-*.png
!webapp/public/apple-touch-icon.png
!labos-kernel/web/favicon-*.png
!labos-kernel/web/apple-touch-icon.png
*.log
/tmp/

# 本地私有参考（不入库）
_private-refs/

# 不方便开源的私有材料（市场研究、竞品情报、客户/供应商资料…）
# 放在仓库根的 private/ 下，只留本地，不进版本库，也不推远端。
# ⚠ 注意：已经推过的文件，移到这里只是让它**不再更新**；
#    要让它从 GitHub 历史里彻底消失，需要 git filter-repo 重写历史（见 docs/en/INDEX.md §7）
/private/

# IDE / 工具
.DS_Store
.codebuddy/
.idea/
.vscode/

# 密钥
*.pem
*.key
# TS 增量编译缓存（每次构建都变，不该入库）
*.tsbuildinfo

# 浏览器自动化快照（工具产物，不入库）
.playwright-cli/

# 设备手册原文：标注"内部资料"，只在本机留存，不进仓库
docs/设备/*.pdf
docs/设备/*.docx

# 本地并行工作树（IDE/自动化创建），不该进仓库
.worktrees/

# Spring Boot 运行时依赖由 scripts/build-kernel.sh 从 Maven 拉取，不提交二进制
labos-kernel/lib/spring/

# B 批：Logback 滚动日志
labos-kernel/logs/

# gateway 的 Lettuce/Netty 运行时依赖，由 maven 拉取
labos-gateway/lib/
