<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.labos</groupId>
  <artifactId>labos-gateway</artifactId>
  <version>0.1.0</version>
  <name>labos-gateway</name>
  <description>实验室中控 - 设备网关（长连接 + Redis 状态中心）</description>

  <!--
    刻意不用 Spring Boot / Netty / Redisson：
    网关是"管道"，职责只有三件——维持连接、收发字节、写状态。
    引 Spring 会带来 ~30MB 依赖和 2-3 秒启动时间，现场重启不方便。

    参考实现（biosen-tcp-client）用 Spring Boot + Netty + Redisson，
    那套适合"已经全公司用 Spring"的场景；这里是独立进程，裸 JDK 更合适。
  -->
  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <finalName>labos-gateway</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.labos.gateway.GatewayMain</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
